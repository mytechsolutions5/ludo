{
  "name": "ludo-mobile-game",
  "version": "1.0.0",
  "description": "Full-featured mobile Ludo board game with smart AI bot, pass & play, touch controls, Web Audio, and PWA/Capacitor native support.",
  "main": "index.html",
  "scripts": {
    "start": "serve -p 3000 .",
    "deploy": "npx wrangler deploy",
    "cap:init": "npx @capacitor/cli init",
    "cap:add:android": "npx @capacitor/cli add android",
    "cap:add:ios": "npx @capacitor/cli add ios",
    "cap:open:android": "npx @capacitor/cli open android",
    "cap:open:ios": "npx @capacitor/cli open ios"
  },
  "keywords": ["ludo", "game", "mobile", "pwa", "board-game", "capacitor"],
  "author": "Antigravity",
  "license": "MIT"
}